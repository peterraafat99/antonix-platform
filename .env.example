GOOGLE_API_MOCK=false

# Phase 3+
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=
GEMINI_FALLBACK_MODEL=
EMAIL_PROVIDER=resend
