NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
APP_URL=http://localhost:3000

# Phase 2 Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
