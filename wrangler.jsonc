{
  "name": "antonix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "antonix.nl/*",
      "zone_name": "antonix.nl"
    },
    {
      "pattern": "www.antonix.nl/*",
      "zone_name": "antonix.nl"
    }
  ],
  "vars": {
    "GOOGLE_API_MOCK": "true",
    "APP_URL": "https://antonix.nl"
  }
}
