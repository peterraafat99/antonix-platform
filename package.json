{
  "name": "review-ai-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run",
    "build:worker": "opennextjs-cloudflare build && node scripts/post-build-cloudflare.mjs",
    "deploy:staging": "npm run build:worker && wrangler deploy --env staging",
    "deploy:production": "npm run build:worker && wrangler deploy --env production"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^3.114.0"
  }
}
